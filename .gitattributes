# Unified line endings: always store LF in the repository, avoiding churn between Windows and Linux.
# This is directly relevant to CI — one workflow step runs `git diff --exit-code -- lib`,
# proving that "the committed lib/ matches the current compilation of src/"; line-ending drift would make it report a false alarm.
* text=auto eol=lf

# The following are treated as binary; no text conversion is allowed
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.7z  binary
*.ico binary
*.ttf binary
