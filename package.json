{
  "name": "dsh-comfyui-image",
  "version": "0.1.1",
  "description": "A DSH plugin backed by a local ComfyUI server: generate_image for text-to-image, image-to-image, inpainting and background removal, plus full model/node inspection and arbitrary workflow execution.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "comfyui",
    "image-generation",
    "text2img",
    "img2img",
    "inpaint",
    "remove-background",
    "stable-diffusion",
    "workflow",
    "comfyui-api",
    "model-inspection"
  ],
  "author": "dsh-comfyui-image contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbb316/dsh-comfyui-image.git"
  },
  "bugs": {
    "url": "https://github.com/wbb316/dsh-comfyui-image/issues"
  },
  "homepage": "https://github.com/wbb316/dsh-comfyui-image#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "meta": {
    "title": "ComfyUI Image Generation & Workflows",
    "description": "Adds image generation and full ComfyUI access to DSH: generate_image for common modes, comfyui_inspect for every model and node schema, comfyui_workflow for arbitrary workflows, and comfyui_api for raw endpoints."
  },
  "icon": "./icon.svg",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
