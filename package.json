{
  "name": "dsh-comfyui-workbench",
  "version": "0.7.0",
  "description": "A local ComfyUI workbench for DeepSeek Harness (DSH): image/audio/video generation, W2/W3 sprite cards, local Flux.2-item generation with guided SDXL fallback, Hugging Face downloads, inspection and arbitrary workflows.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "comfyui",
    "image-generation",
    "text2img",
    "img2img",
    "inpaint",
    "remove-background",
    "stable-diffusion",
    "workflow",
    "comfyui-api",
    "model-inspection",
    "workbench",
    "audio",
    "video",
    "music"
  ],
  "author": "dsh-comfyui-workbench contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRealChickenlegs/dsh-comfyui-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/TheRealChickenlegs/dsh-comfyui-workbench/issues"
  },
  "homepage": "https://github.com/TheRealChickenlegs/dsh-comfyui-workbench#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "meta": {
    "title": "ComfyUI Workbench",
    "description": "Adds image/audio/video generation, W2/W3 sprite cards, local Flux.2 Item Studio assets with guided SDXL fallback, Hugging Face model downloads, inspection and arbitrary workflows to DSH."
  },
  "icon": "./icon.svg",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
